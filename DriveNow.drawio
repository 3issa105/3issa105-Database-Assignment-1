      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-6" value="&lt;b&gt;Question&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="275" y="117" width="1425" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-7" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="149" width="55" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-8" value="Section 7.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="149" width="190" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-9" value="For airport branches that stay open 24/7, should OpeningHour and ClosingHour be left NULL when Is24Hours = 1? Also, when a regional director temporarily runs a branch that has no manager, can they manage two branches at the same time?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="149" width="1425" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-10" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="197" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-11" value="Section 7.2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="197" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-12" value="What is the exact passing score out of 100 for training courses (for example 60 or 70), and is it the same score for all courses or different per course?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="197" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-13" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="239" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-14" value="Section 7.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="239" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-15" value="For luxury cars that have their own custom price (like the Mercedes S-Class), do their prices also change across seasons like category rates, or is a single custom rate enough?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="239" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-16" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="281" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-17" value="Section 7.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="281" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-18" value="If a foreign customer lives in Egypt and has both a passport and a residency ID, should we store only the passport number or allow both?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="281" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-19" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="323" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-20" value="Section 7.8, 7.9, 7.10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="323" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-21" value="Can a corporate discount, a promo code, and loyalty points be used together on the same rental, or are promo codes and loyalty points only for individual customers?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="323" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-22" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="365" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-23" value="Section 7.10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="365" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-24" value="How many loyalty points does a customer earn per EGP spent, and how much discount does redeeming points give? Also, do loyalty points expire?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="365" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-25" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="407" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-26" value="Section 7.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="407" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-27" value="How is the late fee calculated when a car comes back after ExpectedReturnDT (is it per hour, a percentage of the daily rate, or a full extra day)?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="407" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-28" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="449" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-29" value="Section 7.15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="449" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-30" value="Does TotalCost on a job card include only the parts used, or does it also add mechanic labor cost based on HoursSpent?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="449" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-31" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="491" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-32" value="Section 7.16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="491" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-33" value="Since corporate clients get one monthly invoice instead of paying per rental, should we add an INVOICE table in Phase 1 that groups multiple rentals into one monthly bill?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="491" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-34" value="&lt;b&gt;2. Assumptions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=1.2;align=left;spacingLeft=10;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="561" width="1670" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-35" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="593" width="55" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-36" value="&lt;b&gt;SRS Section&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="85" y="593" width="190" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-37" value="&lt;b&gt;Assumption&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="275" y="593" width="1425" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-38" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="625" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-39" value="Section 7.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="625" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-40" value="Every branch has at least one employee assigned to it (at least its branch manager), so BRANCH has total participation in Assigned_To. Senior managers have SupervisorID set to NULL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="625" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-41" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="667" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-42" value="Section 7.1 &amp;amp; 7.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="667" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-43" value="A branch manager is an Employee whose JobTitle is 'Manager', and only managers are allowed to blacklist a customer (enforced by application/trigger rules)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="667" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-44" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="709" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-45" value="Section 7.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="709" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-46" value="The minimum hiring age of 21 is checked by comparing DateOfBirth and HireDate (&amp;gt;= 21 years), while Age is kept as a derived attribute on the ERD." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="709" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-47" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="751" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-48" value="Section 7.2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="751" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-49" value="Training attempts are modeled as a weak entity with AttemptNo (1, 2, 3...) per EmployeeID and CourseCode so that every attempt is saved." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="751" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-50" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="793" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-51" value="Section 7.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="793" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-52" value="CustomDailyRate on VEHICLE is optional (NULL by default). When it is NULL, the rental takes the active price from CATEGORY_RATE_HISTORY; when it is filled, it overrides the category price." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="793" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-53" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="835" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-54" value="Section 7.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="835" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-55" value="Every time a vehicle status changes, a row is inserted into VEHICLE_STATUS_LOG (with OldStatus = NULL when the car is first added) so we always know who changed it and when." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="835" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-56" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="877" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-57" value="Section 7.4 &amp;amp; 7.13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="877" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-58" value="Because prices of extras and insurance packages can change, RENTAL_EXTRA and RENTAL_INSURANCE store ChargedDailyRate and ChargedDailyPrice to lock in the price charged on that rental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="877" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-59" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="919" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-60" value="Section 7.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="919" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-61" value="Individual and Corporate customers are disjoint subtypes of CUSTOMER. If a corporate driver rents for his own family (Section 8), he gets his own Individual Customer account." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="919" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-62" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="961" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-63" value="Section 7.10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="961" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-64" value="PointsBalance and LoyaltyTier (Silver, Gold, Platinum) are derived from summing LOYALTY_POINT_MOVEMENT rows instead of storing them manually." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="961" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-65" value="10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1003" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-66" value="Section 7.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1003" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-67" value="CorpCustomerNo and MainAuthDriverNo on RENTAL are filled only for corporate rentals and stay NULL for individual rentals." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="1003" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-68" value="11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1045" width="55" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-69" value="Section 7.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1045" width="190" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-70" value="When a customer extends a rental, a new row is created in RENTAL with ExtendedFromRentalNo pointing to the old RentalNo (with UNIQUE on ExtendedFromRentalNo so a rental is extended directly only once)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="1045" width="1425" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-71" value="12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1093" width="55" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-72" value="Section 7.14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1093" width="190" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-73" value="Damage reports are numbered 1, 2, 3... inside each rental, and UNIQUE(DamageRentalNo, DamageReportNo) on JOB_CARD ensures one damage report leads to at most one repair job." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="275" y="1093" width="1425" height="42" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-74" value="&lt;b&gt;3. Contradictions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=1.2;align=left;spacingLeft=10;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="1163" width="1670" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-75" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="1195" width="55" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-76" value="&lt;b&gt;SRS Sections&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="85" y="1195" width="240" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-77" value="&lt;b&gt;Contradiction Found&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="325" y="1195" width="1375" height="32" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-78" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1227" width="55" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-79" value="Section 7.3 vs Section 7.3 (COO Note)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1227" width="240" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-80" value="Section 7.3 says pricing is set per category as a daily rate, while the COO Note says some luxury cars like the Mercedes S-Class do not follow the category price and have their own price. I handled this by keeping CATEGORY_RATE_HISTORY and adding an optional CustomDailyRate column on VEHICLE." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="325" y="1227" width="1375" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-81" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1275" width="55" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-82" value="Section 7.16 vs Section 7.16 (Finance Note)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1275" width="240" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-83" value="Section 7.16 describes payments per rental (deposit at pickup, final payment at return), while the Finance Note says corporate clients do not pay per rental and get one monthly invoice instead." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="325" y="1275" width="1375" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-84" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1323" width="55" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-85" value="Section 7.7 vs Section 8 (Ms. Rana Adel)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1323" width="240" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-86" value="Section 7.7 says every customer is either Individual or Corporate and authorized drivers are only known through their company, while Ms. Rana Adel mentions that some corporate drivers are also individual customers who rent personally in the summer." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="325" y="1323" width="1375" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-87" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1371" width="55" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-88" value="Sections 7.4 &amp;amp; 7.13 vs Section 8 (Ms. Mai Ibrahim)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="85" y="1371" width="240" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-89" value="Sections 7.4 and 7.13 only mention current daily prices for extras and insurance plus the price charged on each rental, whereas Ms. Mai Ibrahim wants to check the exact price charged on any day in history for categories, insurance, and extras." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="325" y="1371" width="1375" height="48" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>
<diagram id="oP9aS2dF5gH8jK1lM4nB" name="4-Business-Rules">
  <mxGraphModel dx="1422" dy="794" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1020" math="0" shadow="0" background="#ffffff">
    <root>
      <mxCell id="0"/>
      <mxCell id="1" parent="0"/>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-2" value="&lt;b&gt;Name: Ahmed Mohamed Eissa  |  ID: 3issa105  |  Group: Cycle 1 (S1-A10)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#333333;'&gt;Part D: Business Rules Beyond Constraints&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#111827;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="760" height="48" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-3" value="&lt;b&gt;Business Rules That Cannot Be Enforced by Standard SQL Constraints Alone&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=1.2;align=left;spacingLeft=10;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="1670" height="32" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-4" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="117" width="45" height="32" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-5" value="&lt;b&gt;SRS Section&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="75" y="117" width="160" height="32" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-6" value="&lt;b&gt;Business Rule&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="235" y="117" width="355" height="32" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-7" value="&lt;b&gt;Why Constraints Are Not Enough&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="117" width="550" height="32" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-8" value="&lt;b&gt;How to Enforce It&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1140" y="117" width="560" height="32" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-9" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="149" width="45" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-10" value="Section 7.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="149" width="160" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-11" value="An employee cannot be both a Rental Agent and a Mechanic at the same time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="235" y="149" width="355" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-12" value="A CHECK constraint only checks values inside one row of one table. A row in RENTAL_AGENT cannot check if the same EmployeeID already exists in MECHANIC." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="149" width="550" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-13" value="Use an AFTER/INSTEAD OF INSERT trigger on RENTAL_AGENT and MECHANIC to reject duplicate EmployeeIDs across both tables, or validate it in a stored procedure when assigning employee roles." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="149" width="560" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-14" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="215" width="45" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-15" value="Section 7.7, 7.11 &amp;amp; 7.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="215" width="160" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-16" value="A blacklisted customer cannot book a reservation or open a rental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="235" y="215" width="355" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-17" value="The blacklist columns (BlacklistDate, BlacklistReason, BlacklistedByEmpID) are in CUSTOMER, while bookings and rentals are inserted into RESERVATION and RENTAL. A CHECK constraint cannot query another table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="215" width="550" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-18" value="Use a trigger on RESERVATION and RENTAL (before/after insert) that checks CUSTOMER.BlacklistDate IS NULL for that CustomerNo, plus a check in the application booking/checkout code." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="215" width="560" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-19" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="281" width="45" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-20" value="Section 7.7, 7.12 &amp;amp; 7.16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="281" width="160" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-21" value="A corporate customer's unpaid balance across rentals must not exceed their approved CreditLimit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="235" y="281" width="355" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-22" value="CreditLimit is stored on CORPORATE_CUSTOMER, while total unpaid balance must be summed across multiple rows in RENTAL and PAYMENT. Standard constraints cannot aggregate rows across tables." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="281" width="550" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-23" value="Enforce inside a stored procedure (such as sp_CreateRental) or in the application backend inside a database transaction that sums unpaid balances before creating the new rental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="281" width="560" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-24" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="347" width="45" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-25" value="Section 7.9 &amp;amp; 7.11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="347" width="160" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-26" value="A promo code can only be used within its validity dates and before reaching its MaxUses limit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="235" y="347" width="355" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-27" value="MaxUses, ValidFrom, and ValidTo are in PROMO_CODE, while usages are counted by counting rows in RESERVATION. A CHECK constraint cannot count rows in another table." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="347" width="550" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-28" value="Use a stored procedure or a trigger on RESERVATION that checks the reservation date is between ValidFrom and ValidTo and verifies COUNT(*) of active uses is less than MaxUses." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="347" width="560" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-29" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="413" width="45" height="84" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-30" value="Section 7.6 &amp;amp; 7.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="413" width="160" height="84" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-31" value="A vehicle transfer's FromBranchCode must match the vehicle's current branch, and transferring a car must update VEHICLE.CurrentBranchCode to ToBranchCode." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="235" y="413" width="355" height="84" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-32" value="Although FromBranchCode &amp;lt;&amp;gt; ToBranchCode can be written as a table CHECK, checking VEHICLE.CurrentBranchCode and updating another table cannot be done with constraints." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="413" width="550" height="84" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-33" value="Use an AFTER INSERT trigger on VEHICLE_TRANSFER (or a stored procedure) to confirm FromBranchCode equals VEHICLE.CurrentBranchCode and Status = 'Available', then update VEHICLE.CurrentBranchCode." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="413" width="560" height="84" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-34" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="497" width="45" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-35" value="Section 7.12 &amp;amp; 7.14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="497" width="160" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-36" value="A traffic violation's date and time (ViolationDT) must fall inside the pickup and return period of the matched rental." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="235" y="497" width="355" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-37" value="ViolationDT is in TRAFFIC_VIOLATION while PickupDT and ActualReturnDT are in RENTAL, and CHECK constraints cannot compare columns from two different tables." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="590" y="497" width="550" height="66" as="geometry"/></mxCell>
      <mxCell id="oP9aS2dF5gH8jK1lM4nB-38" value="Enforce with a trigger on TRAFFIC_VIOLATION (insert/update) or a stored procedure that verifies ViolationDT &amp;gt;= PickupDT and (ActualReturnDT IS NULL OR ViolationDT &amp;lt;= ActualReturnDT)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="497" width="560" height="66" as="geometry"/></mxCell>
    </root>
  </mxGraphModel>
</diagram>
</mxfile>
