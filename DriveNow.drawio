      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-2" value="&lt;b&gt;Name: Ahmed Mohamed Eissa  |  ID: 3issa105  |  Group: Cycle 1 (S1-A10)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#333333;'&gt;Part C: Questions, Assumptions &amp;amp; Contradictions&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#111827;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="760" height="48" as="geometry"/></mxCell>
      <mxCell id="xZ1cV4bN7mQ2wE5rT8yU-3" value="&lt;b&gt;1. Questions&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=1.2;align=left;spacingLeft=10;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="1670" height="32" as="geometry"/></mxCell>
